<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Gọi Microsoft Graph và endpoint token. :core:network là thư viện KMP không có manifest riêng nên khai báo ở app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- DS-05: biết máy có mạng hay không để hiện thanh "Đang offline" (ConnectivityManager). Quyền thường, không hỏi người dùng. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        CH-04: tắt sao lưu tự động. allowBackup="false" chặn sao lưu đến Android 11;
        dataExtractionRules chặn cả sao lưu đám mây lẫn chuyển máy trên Android 12+.
        localeConfig (ADR-0011): khai báo VI/EN cho bộ chọn ngôn ngữ theo app của hệ thống (Android 13+).
    -->
    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneDriveVibe"
        tools:targetApi="33">
        <!--
            VD-19: xoay màn hình không được làm gián đoạn video. Tự xử lý các thay đổi cấu hình liên quan tới xoay/kích thước để
            Activity không bị tạo lại (Compose tự thích ứng qua LocalConfiguration).

            CD-10: thêm `locale|layoutDirection` để đổi ngôn ngữ trong app (AppCompatDelegate.setApplicationLocales) KHÔNG tạo lại
            Activity: AppCompat cập nhật Resources rồi gọi onConfigurationChanged, Compose dựng lại chữ qua LocalConfiguration. Nếu
            tạo lại thì cửa sổ bị dựng lại từ đầu, màn hình chớp theme hệ thống trước khi theme đã chọn kịp áp dụng (lỗi 2026-10-07).
            Cố ý KHÔNG có `uiMode`: đổi chế độ tối của hệ thống vẫn tạo lại Activity.

            Toàn app chỉ hiển thị DỌC (`screenOrientation="portrait"`, quyết định 2026-10-07, không liên quan Cài đặt). Riêng màn xem
            video được xoay ngang bằng nút xoay: PlayerOrientationEffect đặt `requestedOrientation` lúc chạy (ghi đè thuộc tính này)
            và trả về PORTRAIT khi rời màn. Đừng trả về UNSPECIFIED vì như vậy cũng ghi đè khóa dọc ở đây.
        -->
        <activity
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|locale|layoutDirection"
            android:exported="true"
            android:name=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ADR-0011: Android 12 trở xuống không tự lưu ngôn ngữ đã chọn trong app; AppCompat lưu giúp qua service này
            (autoStoreLocales). Android 13+ do hệ thống lưu.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
