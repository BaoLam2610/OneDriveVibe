<?xml version="1.0" encoding="utf-8"?>
<!--
    CH-04: dữ liệu app không được đưa vào sao lưu. Android 12+ bỏ qua allowBackup="false" khi chuyển dữ liệu giữa hai máy
    (device-to-device), nên loại trừ tường minh mọi miền cho cả sao lưu đám mây lẫn chuyển máy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
