<resources>
    <!--
        Theme cửa sổ cho AppCompatActivity (ADR-0011 cần AppCompat để đổi ngôn ngữ trong app).
        Giao diện thật vẽ bằng Compose qua ODVTheme; theme này chỉ đặt nền cửa sổ khớp token `bg` (odv_window_bg) để không chớp nền
        trắng hoặc đen trước khung đầu. Android 12+ dùng values-v31/themes.xml (thêm cấu hình splash hệ thống).
    -->
    <style name="Theme.OneDriveVibe" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/odv_window_bg</item>
    </style>

    <!--
        Ép nền cửa sổ theo giao diện đã chọn trong app, bất kể giao diện của máy. MainActivity gọi setTheme(...) trước super.onCreate với một trong
        hai theme này khi người dùng chọn Sáng hoặc Tối (Theo hệ thống thì giữ Theme.OneDriveVibe). Bản v31 thêm cả nền splash hệ thống.
    -->
    <style name="Theme.OneDriveVibe.Light" parent="Theme.OneDriveVibe">
        <item name="android:windowBackground">@color/odv_bg_light</item>
    </style>

    <style name="Theme.OneDriveVibe.Dark" parent="Theme.OneDriveVibe">
        <item name="android:windowBackground">@color/odv_bg_dark</item>
    </style>
</resources>
